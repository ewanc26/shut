{
  "name": "shut",
  "version": "0.1.0",
  "description": "A Bluesky labeller that hides incel language.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server/main.ts",
    "check": "tsx src/cli/check.ts",
    "declare": "tsx --env-file-if-exists=.env src/cli/declare.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test \"test/**/*.test.ts\"",
    "sample": "tsx src/cli/sample.ts"
  },
  "dependencies": {
    "@skyware/jetstream": "^0.2.5",
    "@skyware/labeler": "^0.2.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fastify": "^5.12.5",
    "@fastify/websocket": "^11.0.0"
  }
}
