{
	"name": "shut",
	"private": true,
	"version": "0.1.0",
	"description": "A Bluesky labeller that hides incel language.",
	"license": "MIT",
	"author": "Ewan Croft",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ewanc26/shut.git"
	},
	"packageManager": "pnpm@12.18.0",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "pnpm --filter shut-website dev",
		"build": "pnpm -r run build",
		"check": "pnpm -r run check",
		"test": "pnpm -r run test",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"start": "pnpm --filter shut-labeller start",
		"judge": "pnpm --filter shut-labeller judge",
		"sample": "pnpm --filter shut-labeller sample",
		"declare": "pnpm --filter shut-labeller declare",
		"setup-account": "pnpm --filter shut-labeller setup-account",
		"activate": "pnpm --filter shut-labeller activate"
	},
	"devDependencies": {
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1"
	}
}
