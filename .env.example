# The labeller account's DID (not its handle).
LABELER_DID=did:plc:replace-me
# Hex private key printed by `openssl rand -hex 32`. Keep it secret.
SIGNING_KEY=

# Where the server listens. Put an HTTPS reverse proxy or tunnel in front.
HOST=127.0.0.1
PORT=14831
# Holds the label database and the Jetstream cursor. Back this up.
# DATA_DIR=/absolute/path   (default: data/ at the repository root)
# JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# "off" stops the labeller fetching the existing profiles of accounts it sees posting.
# PROFILE_CHECK=on
# Only for `pnpm backfill`. Create a token at https://bsky.network/account.
# JETSTREAM_API_KEY=
# BACKFILL_DB=/absolute/path   (default: backfill.db in DATA_DIR)
# BACKFILL_MAX_GIB=10   (the scan stops once its queue and labels.db take this much disk)
# Experimental: "shadow" logs what an AI model would label. It never writes labels.
# It sends the text of ambiguous posts and profiles to the provider below.
# Read "Experimental judge" in the README, including the terms, before turning it on.
# AI_JUDGE=off
# AI_JUDGE_DAILY_LIMIT=200
# opencode (default), ollama, lmstudio, custom, or a hosted provider listed in the README.
# AI_JUDGE_PROVIDER=opencode
# With opencode: deepseek-v4.1-flash-free (default) or hy4-flash-free. Otherwise required.
# AI_JUDGE_MODEL=
# Needed by hosted providers. Keep it secret. Not used with opencode.
# AI_JUDGE_API_KEY=
# Needed by custom; replaces a provider's usual address. In Docker, a model server on the
# host is http://host.docker.internal:11434/v1 for Ollama.
# AI_JUDGE_BASE_URL=
# Tried in order when the service above is rate limited or fails. Each takes the same four
# settings; up to three, named AI_JUDGE_FALLBACK_, AI_JUDGE_FALLBACK_2_ and ..._3_.
# AI_JUDGE_FALLBACK_PROVIDER=ollama
# AI_JUDGE_FALLBACK_MODEL=qwen3.5:0.8b
# AI_JUDGE_FALLBACK_BASE_URL=
# AI_JUDGE_FALLBACK_API_KEY=# "shadow" learns word counts from new posts, taught by the word list, and logs what it
# would label. It never writes labels. Only counts are saved, to judge-counts.json in DATA_DIR.
# AI_LEARNER=off

# Pause while the machine is busy. Run `pnpm monitor` on the host, writing the same file.
# SCHEDULE_FILE=/absolute/path/schedule.json   (default: unset, never pause)
# SCHEDULE_MAX_DELAY_MINUTES=60   (the labeller then catches up, however busy; at most 1440)
# MONITOR_BUSY_CPU=70   (percent of all processors at which the monitor calls it busy)
# MONITOR_CALM_CPU=50   (percent at or below which it is calm again)

# Only for `pnpm declare --publish`. The account password, not an app password.
# Pass these on the command line, so they are not left in this file.
# LABELER_PASSWORD=
# PDS_URL=https://bsky.social
# LABELER_2FA_CODE=

# For `pnpm activate`: read SIGNING_KEY from a file kept outside the repository.
# SIGNING_KEY_FILE=
