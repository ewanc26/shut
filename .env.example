# The labeller account's DID (not its handle).
LABELER_DID=did:plc:replace-me
# Hex private key printed by `openssl rand -hex 32`. Keep it secret.
SIGNING_KEY=

# Where the server listens. Put an HTTPS reverse proxy or tunnel in front.
HOST=127.0.0.1
PORT=14831
# Holds the label database and the Jetstream cursor. Back this up.
# DATA_DIR=/absolute/path   (default: data/ at the repository root)
# JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# Experimental: "shadow" logs what a Claude model would label. It never writes labels.
# It sends the text of ambiguous posts and profiles to Anthropic, and costs money.
# AI_JUDGE=off
# ANTHROPIC_API_KEY=            # keep it secret
# AI_JUDGE_DAILY_LIMIT=2000

# Only for `pnpm declare --publish`. The account password, not an app password.
# Pass these on the command line, so they are not left in this file.
# LABELER_PASSWORD=
# PDS_URL=https://bsky.social
# LABELER_2FA_CODE=

# For `pnpm activate`: read SIGNING_KEY from a file kept outside the repository.
# SIGNING_KEY_FILE=
